# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values. `.env` is read automatically by `docker compose up` - never
# commit the filled-in version to git (add `.env` to .gitignore).
# On Railway, don't upload this file - set these same keys/values in the
# Railway dashboard's Variables tab instead.

# --- Required ---
# Your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# --- Optional (defaults shown) ---
# Which model OpenRouter routes the chat completion to.
LLM_MODEL=openai/gpt-3.5-turbo

# Paths *inside the container* - only change these if you edited the
# Dockerfile/compose volume mounts to use different paths.
EMOTION_MODEL_PATH=/app/models/emotion_model.keras
TTS_WEIGHTS_DIR=/app/models
TTS_OUTPUT_DIR=/tmp/tts_out

# --- Only needed for Railway deploys (entrypoint.sh uses these to fetch
# weights into the volume on first boot). Direct-download URLs, e.g. from
# a public Hugging Face Hub repo: https://huggingface.co/<user>/<repo>/resolve/main/<file>
# Leave unset for local docker-compose runs - the bind mount handles it there.
EMOTION_MODEL_URL=
TTS_CONDITIONER_URL=
TTS_VOCODER_URL=

